#!/usr/bin/env sh
# pre-commit 凭据闸 — 在凭据进 git 历史**之前**拦住它。
#
# 这是 .gitignore 之外的第二道防线。.gitignore 会漏（规则写错、路径写深了、
# `git add -f`），而凭据一旦进了历史就等于公开了：rewriting 掉历史不能撤回
# 已经被人 clone 过的那个事实。跳过：git commit --no-verify
#
# ⚠ 扫描的是**暂存区内容**（git show ":$f"），不是工作区文件。
#   扫工作区会漏掉「暂存的是旧版本」这种情况，而那正是会被提交进去的字节。
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 针对 provider 前缀与 PEM 私钥，刻意收窄以压低误报。
# 本项目真实该拦的是 OpenAI/Anthropic 形态的 key 与 GitHub token。
pattern='sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# 显式豁免标记。**故意**持有假 key 的文件（CI 探针、扫描器自检、测试夹具）
# 必须在文件里写一行豁免标记才会被跳过。
#
# 为什么要留这条路：没有它就只能 `--no-verify`，而那个习惯一旦养成，
# 真 key 也一起过去了——一个总被人绕过的钩子等于没有钩子。
# 标记是逐文件的、出现在 diff 里、可被 review 看见的，比整目录跳过安全。
#
# ⚠⚠ **下面这个标记是故意拆成两段再拼回来的，不要合并成一行。**
#
# 2026-10-18 实测踩到：判据是「文件里**任何一行**含这个标记就豁免整个文件」，
# 于是**写出这段标记的文件自己把持有了它**——
#   · 本文件（注释里有一行、下面 `marker=` 赋值也有一行）⇒ 钩子自己不扫描自己
#   · `CONTRIBUTING.md` 第 160 行在**教人怎么写这个标记** ⇒ 那份文档自己不扫描
# 两者都意味着「往这两个文件里粘一个真 key，闸门不会响」。
# ⇒ 标记一旦以完整形式出现在某个文件里，那个文件就永久免检。
# 拆开写是唯一能既「教得会」又「自己不中招」的办法：
# 本文件里只有两段残片，`grep -F` 匹配不上，于是钩子重新开始扫自己。
# ⚠ 反过来说：**别在注释里把完整标记写出来**，一写就等于给自己开免检。
marker='secret-scan:'
marker="$marker allow"

hits=""
for f in $staged; do
  # 夹具与测试里放的是**故意的假 key**（secret-scan 的 canary），
  # 拦下来只会让人养成 --no-verify 的习惯。
  case "$f" in
    *.example|*.example.*|*.sample|.env.example) continue ;;
    crates/capture/fixtures/*) continue ;;
    tests/*|*/tests/*|test_*|*_test.*|*/conftest.py) continue ;;
  esac
  [ -f "$f" ] || continue
  # 文件自己声明了豁免就跳过。判的是暂存内容，与下面扫的是同一份字节。
  if git show ":$f" 2>/dev/null | grep -qF "$marker"; then
    echo "  (豁免) $f —— 文件内含 '$marker'"
    continue
  fi
  if git show ":$f" 2>/dev/null | grep -nE "$pattern" >/dev/null 2>&1; then
    hits="$hits $f"
  fi
done

if [ -n "$hits" ]; then
  echo "✗ pre-commit: 暂存内容里疑似有凭据：" >&2
  for f in $hits; do echo "    $f" >&2; done
  echo "  如果那是真凭据，**不要提交**——它只该待在 Windows 凭据管理器" >&2
  echo "  或环境变量里（见硬约束第 7 条）。已经提交过就要当泄露处理：先轮换。" >&2
  echo "  误报？重跑：git commit --no-verify" >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────
# 第二道闸：取证图 / 聊天内容（硬约束第 3 条「截图不落盘、不上传」）
#
# 为什么必须单独一道：上面的凭据闸按**内容**匹配，而聊天截图是二进制，
# 匹配不出来。防它只能按**路径**——而按路径的规则只有 .gitignore 一处，
# 它是会漏的（规则写错、路径写深了、`git add -f`）。
# 本仓库公开在 GitHub 上，一次漏进去就是别人的聊天窗口被公开。
#
# 判据是「暂存路径落在取证目录里」，不是「这文件像不像图」——
# 后者会误伤正常的设计图（`ui/static/`、图标、夹具）。
# ─────────────────────────────────────────────────────────────────────
leak=""
for f in $staged; do
  # ⚠⚠ **合法图片白名单。** 2026-10-18 实测 `git ls-files` 枚举全仓库被跟踪的
  # 图片，**共 7 张**（枚举命令见本文件末尾，验收时用它复核）。
  # 这里按「来源」而不是「一张张列文件名」来放行：图标目录整目录进白名单，
  # 而 `ui/static/` 那两张**刻意逐个点名**——`ui/static/` 是前端静态资源目录，
  # 将来往里丢张聊天截屏是最自然的手滑，放行整个目录等于把缺口重新打开。
  # ⇒ 新增合法图片要显式改这一行，这是**有意的摩擦**。
  case "$f" in
    ui/src-tauri/icons/*) continue ;;
    ui/static/probe-sheet.png|ui/static/strip.png) continue ;;
  esac

  case "$f" in
    # 探针产物目录：里面是什么扩展名都拦（可能是 .json / .txt 的读数）
    target/*|*/target/*|probe-out/*|*/probe-out/*|.scratch/tmp-probe/*)
      leak="$leak $f" ;;
    # ⚠⚠ **图片一律按扩展名判，不看目录名。**
    #
    # 原来的判据是 `*/probe/*.png`，只认「目录名叫 probe」——
    # 于是把聊天截图拖到仓库根、命名 `shot.png` 就直接进了 git 历史，
    # 而本仓公开在 GitHub 上。实证盲区不止假想：合法资产
    # `ui/static/probe-sheet.png` 就因为「probe 是文件名前缀、不是目录」
    # 而没被那条规则匹配到，说明这条判据**两边都不准**。
    #
    # 判据改成「扩展名 ∈ 图片集合」之后，「是不是截图」与「它在哪」无关。
    *.png|*.jpg|*.jpeg|*.bmp|*.webp|*.gif|*.PNG|*.JPG|*.JPEG|*.BMP|*.WEBP|*.GIF)
      leak="$leak $f" ;;
  esac
done

if [ -n "$leak" ]; then
  echo "✗ pre-commit: 暂存内容里有图片或探针产物（硬约束第 3 条：截图不落盘、不上传）：" >&2
  for f in $leak; do echo "    $f" >&2; done
  echo "  聊天截图、取证帧、探针输出目录里的东西，**都可能含真实聊天内容**，" >&2
  echo "  而本仓公开在 GitHub 上 ⇒ 漏进去就是别人的聊天窗口被公开。" >&2
  echo "  确认是设计资产（图标 / 排版稿）？把路径加进上面「合法图片白名单」，" >&2
  echo "  让它出现在 diff 里被 review 看见——别用 --no-verify 硬闯。" >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────
# 枚举复核用（不是判据，是给人核对白名单是否过期的命令）：
#   git ls-files | grep -Ei '\.(png|jpe?g|bmp|webp|gif)$'
# 2026-10-18 实测输出 7 张，与白名单逐条一致。
# ⚠ 不一致说明期间漏进来过东西——那时该做的是查 git 历史，不是改白名单。
# ⚠ 这也正是本闸门与凭据闸的共同盲区：闸门自己没有任何机器守卫，
#   「它是否还在、判据是否还是那样」只有这一行注释提醒人去看。
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# 第三道闸：真人聊天**原文**（硬约束第 3 条「文字」那一半）
#
# 上面第二道闸按**扩展名**拦图片；这一道拦**文字**。
# 图片被 .gitignore 拦住了，文字没有 ⇒ 2026-10-24 票 93：
# 真机截图里一条真人会话气泡的原文被抄进了票面，随提交进了**公开仓**
# （本仓在 GitHub 上）⇒ 文字这一半从今天起有机器守卫。
#
# 判据是**字面黑名单**：本机真帧的 OCR 文本
# （target/probe/real-chat-blacklist.txt，本机私有、gitignored）
# 逐字比对暂存区新增行。
# ⚠ 它**不是**启发式（「像不像真人聊天」）——那种判据不可靠，
#   硬做成守卫只会得到一条永远绿着的假判据（AGENTS.md 明写）。
#
# ⚠⚠ 缺黑名单 ⇒ 这一步**没有结论**，不是「没问题」。
#   所以打横幅、exit 0，**不许静默跳过**（票 67 的教训）。
#   黑名单由 scripts/refresh-real-chat-blacklist.ps1 生成。
#
# ⚠ **提交信息**那一半在 .githooks/commit-msg 里：
#   实测 2026-10-24，pre-commit 阶段本次提交信息还没定下来
#   （.git/COMMIT_EDITMSG 那会儿只有上一次的残留）。
# ─────────────────────────────────────────────────────────────────────
blacklist='target/probe/real-chat-blacklist.txt'
if [ ! -s "$blacklist" ]; then
  echo '!! 本次没有黑名单 ⇒ 没扫真人原文（缺 target/probe/real-chat-blacklist.txt）' >&2
  echo '   ⇒ 先跑：pwsh -NoProfile -File scripts/refresh-real-chat-blacklist.ps1' >&2
  exit 0
fi
if ! command -v pwsh >/dev/null 2>&1; then
  echo '✗ pre-commit: 找不到 pwsh（PowerShell 7），真人原文这道闸跑不了。' >&2
  echo '  ⇒ 装 PowerShell 7；或 git commit --no-verify（但那会连凭据闸一起跳过）。' >&2
  exit 1
fi
if ! pwsh -NoProfile -File scripts/check-real-chat.ps1; then
  echo '✗ pre-commit: 真人聊天原文这道闸没过。' >&2
  exit 1
fi

exit 0
