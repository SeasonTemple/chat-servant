{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chat-servant",
  "version": "0.1.0",
  "identifier": "dev.chatservant.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "副驾",
        "url": "/",
        "width": 380,
        "height": 560,
        "minWidth": 340,
        "minHeight": 380,
        "resizable": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "/settings",
        "width": 640,
        "height": 520,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "debug",
        "title": "识别画布",
        "url": "/debug",
        "width": 760,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "appDirectoriesOverride": "./app-data"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
